{
  "id": "./",
  "name": "No Contact Dude",
  "short_name": "NC Dude",
  "description": "No Contact Dude: a private, offline-first No Contact tracker. Daily check-ins, streaks, milestones and urgent help stored only on your device.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0B1F23",
  "theme_color": "#58CC02",
  "categories": [
    "health",
    "lifestyle",
    "productivity"
  ],
  "lang": "en-GB",
  "dir": "ltr",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Check in today",
      "short_name": "Check in",
      "url": "./?action=checkin",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "I need help now",
      "short_name": "Urgent help",
      "url": "./?action=urgent",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
